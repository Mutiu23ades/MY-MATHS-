function showTopic() {

    const select = document.getElementById("topicSelect");
    const content = document.getElementById("content");

    const value = select.value;

    if (value === "") {
        content.style.display = "none";
        content.innerHTML = "";
        return;
    }

    const topic = topics[value];

    if (!topic) {
        content.innerHTML = "<p>Topic not found.</p>";
        content.style.display = "block";
        return;
    }

    content.innerHTML = `
        <h2>Topic ${value}: ${topic.title}</h2>

        <h3>📘 Lesson</h3>
        <div>
            ${topic.lesson}
        </div>

        <h3>✏️ Worked Examples</h3>
        <div class="example">
            ${topic.example}
        </div>

        <h3>📝 Practice Questions</h3>
        <div class="practice">
            ${topic.practice}
        </div>

        <h3>✅ Answers</h3>
        <div class="answer">
            ${topic.answer}
        </div>

        <button onclick="window.scrollTo({top:0, behavior:'smooth'})">
            ↑ Back to Top
        </button>
    `;

    content.style.display = "block";

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

